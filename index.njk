<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>DavisSon &amp; Associates Inc. — Chartered Certified Accountant, Barbados</title>
<meta name="description" content="Comprehensive financial services from bookkeeping to strategic advisory. Barbados-based chartered certified accountants serving the Caribbean."/>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;0,700;1,300;1,400;1,600&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet"/>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --navy:#001F5B;--navy-deep:#000E2B;
  --gold:#C9A84C;--gold-light:#E8C97A;
  --cream:#FAF8F3;--white:#FFFFFF;
  --charcoal:#1C1C1C;--mid:#4A4A4A;--light:#8A8A8A;
  --border:#E5E0D8;--blue-wash:#F0F4FF;
}
html{scroll-behavior:smooth}
body{font-family:"Inter",sans-serif;background:var(--white);color:var(--charcoal);overflow-x:hidden;-webkit-font-smoothing:antialiased}
.reveal{opacity:0;transform:translateY(20px);transition:opacity .9s ease,transform .9s ease}
.reveal.left{transform:translateX(-20px)}
.reveal.right{transform:translateX(20px)}
.reveal.visible{opacity:1;transform:none}
.d1{transition-delay:.15s}.d2{transition-delay:.3s}.d3{transition-delay:.45s}.d4{transition-delay:.6s}
@keyframes ticker{from{transform:translateX(0)}to{transform:translateX(-50%)}}
@media(prefers-reduced-motion:reduce){.reveal{opacity:1;transform:none;transition:none}}

/* NAV */
#nav{position:fixed;top:0;left:0;right:0;z-index:100;display:flex;align-items:center;justify-content:space-between;padding:0 4vw;height:80px;background:transparent;transition:background .4s,box-shadow .4s}
#nav.solid{background:rgba(255,255,255,0.98);box-shadow:0 1px 24px rgba(0,0,0,.06)}
.logo{text-decoration:none}
.logo-name{font-family:"Cormorant Garamond",serif;font-size:1.25rem;font-weight:600;color:var(--white);display:block;transition:color .3s}
.logo-tag{font-size:.55rem;font-weight:500;letter-spacing:.22em;text-transform:uppercase;color:var(--gold-light);display:block;margin-top:1px;transition:color .3s}
#nav.solid .logo-name{color:var(--navy)}
#nav.solid .logo-tag{color:var(--gold)}
.nav-links{display:flex;align-items:center;gap:2.5rem;list-style:none}
.nav-links a{font-size:.72rem;font-weight:500;letter-spacing:.06em;text-transform:uppercase;color:rgba(255,255,255,.75);text-decoration:none;transition:color .2s}
.nav-links a:hover{color:var(--white)}
#nav.solid .nav-links a{color:var(--mid)}
#nav.solid .nav-links a:hover{color:var(--navy)}
.nav-book{font-size:.7rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--navy);background:var(--gold);padding:.6rem 1.5rem;text-decoration:none;transition:background .2s}
.nav-book:hover{background:var(--gold-light)}
.ham{display:none;flex-direction:column;gap:5px;background:none;border:none;cursor:pointer;padding:4px}
.ham span{display:block;width:22px;height:1.5px;background:var(--white);transition:.3s}
#nav.solid .ham span{background:var(--navy)}
.mob-menu{display:none;position:fixed;top:80px;left:0;right:0;background:var(--white);z-index:99;flex-direction:column;border-bottom:2px solid var(--gold);box-shadow:0 8px 32px rgba(0,0,0,.1)}
.mob-menu.open{display:flex}
.mob-menu a{padding:1rem 4vw;font-size:.82rem;font-weight:500;letter-spacing:.06em;text-transform:uppercase;color:var(--navy);text-decoration:none;border-bottom:1px solid var(--border)}

/* HERO */
#hero{position:relative;height:100vh;min-height:640px;display:grid;grid-template-rows:1fr auto;overflow:hidden}
.hero-bg{position:absolute;inset:0;background:url("/images/uploads/pawel-czerwinski-prMn9KINLtI-unsplash.jpg") center/cover no-repeat}
.hero-overlay{position:absolute;inset:0;background:linear-gradient(to right,rgba(0,14,43,0.88) 0%,rgba(0,14,43,0.65) 55%,rgba(0,14,43,0.25) 100%)}
.hero-overlay-b{position:absolute;bottom:0;left:0;right:0;height:45%;background:linear-gradient(to top,rgba(0,14,43,.65),transparent)}
.hero-top{position:relative;z-index:2;padding:calc(80px + 2.5rem) 4vw 0}
.hero-label{display:inline-flex;align-items:center;gap:.7rem;font-size:.64rem;font-weight:600;letter-spacing:.25em;text-transform:uppercase;color:var(--gold-light)}
.hero-label::before{content:"";width:28px;height:1px;background:var(--gold)}
.hero-content{position:relative;z-index:2;padding:0 4vw 6rem;max-width:780px}
.hero-h1{font-family:"Cormorant Garamond",serif;font-size:clamp(2.8rem,5.5vw,5.5rem);font-weight:300;line-height:1.08;color:var(--white);margin-bottom:1.8rem}
.hero-h1 strong{font-weight:600}
.hero-h1 em{font-style:italic;color:var(--gold-light)}
.hero-sub{font-size:.98rem;line-height:1.78;color:rgba(255,255,255,.68);max-width:480px;margin-bottom:2.5rem}
.hero-ctas{display:flex;gap:1rem;align-items:center;flex-wrap:wrap}
.cta-p{background:var(--gold);color:var(--navy-deep);padding:.85rem 2.2rem;font-size:.75rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;text-decoration:none;transition:background .2s,transform .15s}
.cta-p:hover{background:var(--gold-light);transform:translateY(-2px)}
.cta-g{color:rgba(255,255,255,.82);font-size:.75rem;font-weight:500;letter-spacing:.08em;text-transform:uppercase;text-decoration:none;border-bottom:1px solid rgba(255,255,255,.35);padding-bottom:2px;transition:color .2s}
.cta-g:hover{color:var(--white)}
.hero-scroll{position:absolute;bottom:2.5rem;right:4vw;z-index:2;display:flex;flex-direction:column;align-items:center;gap:.6rem;color:rgba(255,255,255,.4);font-size:.58rem;letter-spacing:.15em;text-transform:uppercase}
.hero-scroll::after{content:"";width:1px;height:48px;background:rgba(255,255,255,.2)}

/* TICKER */
.ticker{background:var(--navy);padding:.8rem 0;overflow:hidden;white-space:nowrap}
.ticker-track{display:inline-flex;animation:ticker 40s linear infinite}
.tick{display:inline-flex;align-items:center;padding:0 3rem;font-size:.63rem;font-weight:500;letter-spacing:.18em;text-transform:uppercase;color:rgba(255,255,255,.45)}
.tick::after{content:"·";color:var(--gold);font-size:1.1rem;margin-left:3rem}

/* SHARED */
.sec-label{font-size:.6rem;font-weight:600;letter-spacing:.22em;text-transform:uppercase;color:var(--gold);margin-bottom:1rem;display:flex;align-items:center;gap:.7rem}
.sec-label::before{content:"";width:20px;height:1px;background:var(--gold)}
.sec-title{font-family:"Cormorant Garamond",serif;font-size:clamp(2rem,3.5vw,3.2rem);font-weight:300;color:var(--navy);line-height:1.15;margin-bottom:1.2rem}
.sec-title strong{font-weight:600}
.sec-title em{font-style:italic}
.sec-body{font-size:.94rem;line-height:1.82;color:var(--mid)}

/* ABOUT */
#about{display:grid;grid-template-columns:1fr 1fr;min-height:620px}
.about-img{position:relative;overflow:hidden;background:url("/images/uploads/kathryn-maingot--76qup1BmIs-unsplash.jpg") center/cover no-repeat;min-height:500px}
.about-img-ov{position:absolute;inset:0;background:linear-gradient(135deg,rgba(0,31,91,.75) 0%,rgba(0,31,91,.25) 100%)}
.about-img-text{position:absolute;bottom:2.5rem;left:2.5rem;right:2.5rem;z-index:2}
.about-quote{font-family:"Cormorant Garamond",serif;font-size:1.45rem;font-weight:300;font-style:italic;color:var(--white);line-height:1.45;border-left:3px solid var(--gold);padding-left:1.2rem}
.about-quote cite{display:block;margin-top:.8rem;font-family:"Inter",sans-serif;font-style:normal;font-size:.62rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--gold-light)}
.about-content{background:var(--cream);padding:6rem 5vw;display:flex;flex-direction:column;justify-content:center}
.about-stats{display:grid;grid-template-columns:1fr 1fr;gap:1.8rem;margin:2.5rem 0;padding:2rem 0;border-top:1px solid var(--border);border-bottom:1px solid var(--border)}
.stat-v{font-family:"Cormorant Garamond",serif;font-size:2.8rem;font-weight:300;color:var(--navy);line-height:1}
.stat-l{font-size:.62rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--light);margin-top:.3rem}
.about-pills{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:1.5rem}
.pill{background:var(--white);border:1px solid var(--border);color:var(--mid);padding:.35rem .9rem;font-size:.72rem;font-weight:500}

/* SERVICES */
#services{padding:7rem 4vw;background:var(--white)}
.svc-head{display:grid;grid-template-columns:1fr 1fr;gap:4vw;align-items:end;margin-bottom:5rem}
.svc-head-r p{font-size:.92rem;line-height:1.82;color:var(--mid)}
.svc-head-link{display:inline-flex;align-items:center;gap:.5rem;margin-top:1.5rem;font-size:.74rem;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--navy);text-decoration:none;border-bottom:1px solid var(--gold);padding-bottom:3px}
.svc-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--border)}
.svc{background:var(--white);padding:2.5rem 2.2rem;position:relative;overflow:hidden;cursor:default;transition:background .3s}
.svc::before{content:"";position:absolute;top:0;left:0;right:0;height:3px;background:var(--gold);transform:scaleX(0);transform-origin:left;transition:transform .3s}
.svc:hover{background:var(--navy)}
.svc:hover::before{transform:scaleX(1)}
.svc:hover .svc-n{color:rgba(255,255,255,.12)}
.svc:hover .svc-t{color:var(--white)}
.svc:hover .svc-d{color:rgba(255,255,255,.52)}
.svc-n{font-family:"Cormorant Garamond",serif;font-size:3rem;font-weight:300;color:var(--border);line-height:1;margin-bottom:.8rem;display:block;transition:color .3s}
.svc-t{font-family:"Cormorant Garamond",serif;font-size:1.22rem;font-weight:400;color:var(--navy);margin-bottom:.7rem;transition:color .3s}
.svc-d{font-size:.8rem;line-height:1.72;color:var(--mid);transition:color .3s}

/* PAYROLL */
#payroll{background:var(--navy);padding:7rem 4vw;position:relative;overflow:hidden}
.payroll-inner{display:grid;grid-template-columns:1fr 1fr;gap:6vw;align-items:center}
.pl-label{font-size:.6rem;font-weight:600;letter-spacing:.22em;text-transform:uppercase;color:rgba(201,168,76,.7);margin-bottom:1rem;display:flex;align-items:center;gap:.7rem}
.pl-label::before{content:"";width:20px;height:1px;background:var(--gold)}
.pl-title{font-family:"Cormorant Garamond",serif;font-size:clamp(2rem,3.5vw,3.2rem);font-weight:300;color:var(--white);line-height:1.15;margin-bottom:1.2rem}
.pl-title em{font-style:italic;color:var(--gold-light)}
.pl-body{font-size:.94rem;line-height:1.82;color:rgba(255,255,255,.58);margin-bottom:2.5rem}
.pl-grid{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:rgba(255,255,255,.08)}
.pi{background:rgba(255,255,255,.04);padding:1.5rem;transition:background .2s}
.pi:hover{background:rgba(255,255,255,.09)}
.pi-ico{width:36px;height:36px;border-radius:50%;background:rgba(201,168,76,.12);display:flex;align-items:center;justify-content:center;margin-bottom:.8rem}
.pi-ico svg{stroke:var(--gold)}
.pi-t{font-family:"Cormorant Garamond",serif;font-size:1rem;font-weight:400;color:var(--white);margin-bottom:.3rem}
.pi-d{font-size:.75rem;line-height:1.6;color:rgba(255,255,255,.42)}

/* SOFTWARE */
#software{padding:7rem 4vw;background:var(--cream)}
.sw-inner{display:grid;grid-template-columns:1fr 1fr;gap:6vw;align-items:start}
.qb-badge{display:inline-flex;align-items:center;gap:.8rem;background:var(--white);border:1px solid var(--border);padding:.6rem 1.2rem .6rem .7rem;margin-bottom:2rem}
.qb-ico{width:30px;height:30px;border-radius:4px;background:#2CA01C;display:flex;align-items:center;justify-content:center}
.qb-ico svg{stroke:white}
.qb-main{font-size:.78rem;font-weight:600;color:var(--navy);display:block}
.qb-sub{font-size:.68rem;color:var(--light)}
.sw-highlight{background:var(--navy);padding:2.5rem;margin-top:2rem}
.sw-hl-title{font-family:"Cormorant Garamond",serif;font-size:1.25rem;font-weight:400;color:var(--gold-light);margin-bottom:1.5rem}
.sw-pts{display:flex;flex-direction:column;gap:1rem}
.sw-pt{display:flex;gap:.8rem;align-items:flex-start}
.sw-dot{width:6px;height:6px;border-radius:50%;background:var(--gold);flex-shrink:0;margin-top:.46rem}
.sw-ptxt{font-size:.84rem;color:rgba(255,255,255,.62);line-height:1.6}
.sw-ptxt strong{color:rgba(255,255,255,.9)}
.sw-list{display:flex;flex-direction:column;gap:1px;background:var(--border)}
.sw-row{background:var(--white);padding:1.4rem 1.8rem;display:flex;align-items:center;gap:1.2rem;transition:background .2s,transform .2s}
.sw-row:hover{background:var(--navy);transform:translateX(6px)}
.sw-row:hover .sw-rt{color:var(--white)}
.sw-row:hover .sw-rd{color:rgba(255,255,255,.45)}
.sw-row:hover .sw-rico{background:rgba(201,168,76,.12)}
.sw-row:hover .sw-rico svg{stroke:var(--gold)}
.sw-rico{width:38px;height:38px;border-radius:50%;flex-shrink:0;background:var(--blue-wash);display:flex;align-items:center;justify-content:center;transition:background .2s}
.sw-rico svg{stroke:var(--navy);transition:stroke .2s}
.sw-rt{font-size:.88rem;font-weight:500;color:var(--navy);transition:color .2s}
.sw-rd{font-size:.75rem;color:var(--light);margin-top:.12rem;transition:color .2s}

/* TEAM */
#team{padding:7rem 4vw;background:var(--white)}
.team-intro{display:grid;grid-template-columns:1fr 1fr;gap:4vw;align-items:end;margin-bottom:4rem}
.team-intro-r p{font-size:.92rem;line-height:1.82;color:var(--mid)}
.team-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:2rem;margin-bottom:2rem}
.tc{border-top:3px solid var(--border);padding-top:2rem;transition:border-color .3s}
.tc:hover{border-color:var(--gold)}
.tc-av{width:68px;height:68px;border-radius:50%;background:var(--navy);color:var(--white);display:flex;align-items:center;justify-content:center;font-family:"Cormorant Garamond",serif;font-size:1.4rem;font-weight:300;margin-bottom:1.2rem;border:3px solid transparent;transition:border-color .3s}
.tc:hover .tc-av{border-color:var(--gold)}
.tc-name{font-family:"Cormorant Garamond",serif;font-size:1.3rem;font-weight:400;color:var(--navy);margin-bottom:.2rem}
.tc-cred{font-size:.62rem;letter-spacing:.12em;text-transform:uppercase;color:var(--gold);font-weight:600;margin-bottom:.2rem}
.tc-role{font-size:.78rem;color:var(--light);margin-bottom:1rem}
.tc-div{width:24px;height:1px;background:var(--gold);margin-bottom:.9rem}
.tc-bio{font-size:.82rem;line-height:1.78;color:var(--mid)}
.assoc-bar{background:var(--cream);border:1px solid var(--border);padding:2rem 2.5rem;display:flex;gap:2rem;align-items:flex-start}
.assoc-ico{width:48px;height:48px;border-radius:50%;flex-shrink:0;background:var(--navy);display:flex;align-items:center;justify-content:center}
.assoc-ico svg{stroke:var(--gold-light)}
.assoc-t{font-family:"Cormorant Garamond",serif;font-size:1.1rem;font-weight:400;color:var(--navy);margin-bottom:.4rem}
.assoc-b{font-size:.83rem;line-height:1.72;color:var(--mid)}

/* WHY */
#why{background:var(--cream);padding:7rem 4vw;border-top:1px solid var(--border)}
.why-inner{display:grid;grid-template-columns:1fr 1fr;gap:6vw;align-items:center}
.why-items{display:flex;flex-direction:column;gap:2rem;margin-top:3rem}
.why-item{display:flex;gap:1.5rem;align-items:flex-start}
.why-num{font-family:"Cormorant Garamond",serif;font-size:2.5rem;font-weight:300;color:var(--border);line-height:1;flex-shrink:0;width:3rem;text-align:right}
.why-it{font-family:"Cormorant Garamond",serif;font-size:1.15rem;font-weight:400;color:var(--navy);margin-bottom:.4rem}
.why-ib{font-size:.83rem;line-height:1.72;color:var(--mid)}
.why-cards{display:flex;flex-direction:column;gap:1.5rem}
.why-card{background:var(--white);border:1px solid var(--border);padding:2rem;display:flex;justify-content:space-between;align-items:center}
.why-card.acc{background:var(--navy);border-color:var(--navy)}
.wc-val{font-family:"Cormorant Garamond",serif;font-size:3rem;font-weight:300;color:var(--navy);line-height:1}
.why-card.acc .wc-val{color:var(--gold-light)}
.wc-lab{font-size:.63rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--light);margin-top:.3rem}
.why-card.acc .wc-lab{color:rgba(255,255,255,.45)}
.wc-ico{width:48px;height:48px;border-radius:50%;background:var(--blue-wash);display:flex;align-items:center;justify-content:center}
.why-card.acc .wc-ico{background:rgba(255,255,255,.08)}
.wc-ico svg{stroke:var(--navy)}
.why-card.acc .wc-ico svg{stroke:var(--gold-light)}

/* BLOG */
#blog{padding:7rem 4vw;background:var(--white)}
.blog-hd{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:3.5rem;flex-wrap:wrap;gap:1rem}
.view-all{font-size:.72rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--navy);text-decoration:none;border-bottom:1px solid var(--gold);padding-bottom:3px}
.blog-grid{display:grid;grid-template-columns:1.5fr 1fr 1fr;gap:2rem}
.bc{background:var(--cream);overflow:hidden;transition:box-shadow .3s,transform .3s}
.bc:hover{box-shadow:0 16px 48px rgba(0,31,91,.1);transform:translateY(-4px)}
.bc-img{height:200px;display:flex;align-items:flex-end;padding:1.5rem;position:relative;overflow:hidden}
.bc.feat .bc-img{height:240px}
.bc-img-ov{position:absolute;inset:0;background:linear-gradient(to top,rgba(0,14,43,.82) 0%,transparent 60%)}
.bc-tag{position:relative;z-index:1;font-size:.6rem;letter-spacing:.15em;text-transform:uppercase;font-weight:600;color:var(--gold-light);background:rgba(0,0,0,.3);padding:.25rem .7rem}
.bc-body{padding:1.8rem}
.bc-title{font-family:"Cormorant Garamond",serif;font-size:1.1rem;font-weight:400;color:var(--navy);line-height:1.3;margin-bottom:.7rem}
.bc.feat .bc-title{font-size:1.35rem}
.bc-ex{font-size:.8rem;line-height:1.68;color:var(--mid);margin-bottom:.9rem}
.bc-meta{font-size:.7rem;color:var(--light)}
.bc-link{display:inline-flex;align-items:center;gap:.4rem;font-size:.72rem;font-weight:600;letter-spacing:.05em;text-transform:uppercase;color:var(--navy);text-decoration:none;margin-top:.8rem;border-bottom:1px solid var(--gold);padding-bottom:2px}

/* CONTACT */
#contact{display:grid;grid-template-columns:1fr 1fr;background:var(--navy)}
.contact-left{padding:7rem 4vw;display:flex;flex-direction:column;justify-content:center}
.cl-label{font-size:.6rem;font-weight:600;letter-spacing:.22em;text-transform:uppercase;color:rgba(201,168,76,.7);margin-bottom:1rem;display:flex;align-items:center;gap:.7rem}
.cl-label::before{content:"";width:20px;height:1px;background:var(--gold)}
.cl-title{font-family:"Cormorant Garamond",serif;font-size:clamp(2rem,3.5vw,3.2rem);font-weight:300;color:var(--white);line-height:1.15;margin-bottom:1.2rem}
.cl-title em{font-style:italic;color:var(--gold-light)}
.cl-body{font-size:.94rem;line-height:1.82;color:rgba(255,255,255,.58);margin-bottom:3rem}
.cds{display:flex;flex-direction:column;gap:1.5rem}
.cd{display:flex;gap:1rem;align-items:flex-start}
.cd-ico{width:40px;height:40px;border-radius:50%;flex-shrink:0;border:1px solid rgba(201,168,76,.28);display:flex;align-items:center;justify-content:center}
.cd-ico svg{stroke:var(--gold)}
.cd-lab{font-size:.6rem;font-weight:600;letter-spacing:.15em;text-transform:uppercase;color:var(--gold);margin-bottom:.2rem}
.cd-val{font-size:.86rem;color:rgba(255,255,255,.62);line-height:1.55}
.hrs{margin-top:2.5rem;padding:1.4rem 1.8rem;border:1px solid rgba(201,168,76,.18);display:flex;align-items:center;gap:1rem}
.hrs-ico{width:38px;height:38px;border-radius:50%;flex-shrink:0;background:rgba(201,168,76,.1);display:flex;align-items:center;justify-content:center}
.hrs-ico svg{stroke:var(--gold)}
.hrs-lab{font-size:.6rem;font-weight:600;letter-spacing:.15em;text-transform:uppercase;color:var(--gold);margin-bottom:.2rem}
.hrs-val{font-size:.84rem;color:rgba(255,255,255,.52)}
.contact-right{background:var(--cream);padding:7rem 5vw;display:flex;flex-direction:column;justify-content:center}
.form-h{font-family:"Cormorant Garamond",serif;font-size:1.8rem;font-weight:300;color:var(--navy);margin-bottom:.4rem}
.form-sub{font-size:.82rem;color:var(--light);margin-bottom:2.5rem}
.fg{margin-bottom:1.2rem}
.fg label{display:block;font-size:.62rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--mid);margin-bottom:.4rem}
.fg input,.fg select,.fg textarea{width:100%;padding:.75rem 1rem;border:1px solid var(--border);background:var(--white);font-family:"Inter",sans-serif;font-size:.86rem;color:var(--charcoal);outline:none;transition:border-color .2s;appearance:none}
.fg input:focus,.fg select:focus,.fg textarea:focus{border-color:var(--navy)}
.fg textarea{resize:vertical;min-height:110px}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:1rem}
.form-sub-btn{width:100%;padding:.9rem;background:var(--navy);color:var(--white);border:none;font-family:"Inter",sans-serif;font-size:.76rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;cursor:pointer;transition:background .2s;margin-top:.5rem}
.form-sub-btn:hover{background:var(--navy-deep)}

/* FOOTER */
footer{background:#060810;padding:5rem 4vw 2.5rem}
.ft-grid{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:3rem;padding-bottom:3.5rem;border-bottom:1px solid rgba(255,255,255,.06)}
.ft-name{font-family:"Cormorant Garamond",serif;font-size:1.2rem;font-weight:400;color:var(--white);margin-bottom:.3rem}
.ft-sub{font-size:.55rem;letter-spacing:.22em;text-transform:uppercase;color:var(--gold);margin-bottom:1.2rem}
.ft-desc{font-size:.8rem;color:rgba(255,255,255,.28);line-height:1.82;max-width:250px}
.ft-col h4{font-size:.58rem;letter-spacing:.2em;text-transform:uppercase;color:rgba(255,255,255,.22);font-weight:600;margin-bottom:1.2rem}
.ft-col ul{list-style:none;display:flex;flex-direction:column;gap:.65rem}
.ft-col a{font-size:.8rem;color:rgba(255,255,255,.4);text-decoration:none;transition:color .2s}
.ft-col a:hover{color:var(--gold)}
.ft-bot{padding-top:2rem;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:1rem}
.ft-copy{font-size:.72rem;color:rgba(255,255,255,.18)}
.ft-line{width:32px;height:1px;background:var(--gold);opacity:.45}

/* BACK TO TOP */
#top-btn{position:fixed;bottom:2rem;right:2rem;z-index:99;width:44px;height:44px;background:var(--navy);color:var(--white);border:1px solid rgba(201,168,76,.35);display:flex;align-items:center;justify-content:center;cursor:pointer;opacity:0;visibility:hidden;transform:translateY(12px);transition:opacity .3s,visibility .3s,transform .2s,background .2s}
#top-btn.show{opacity:1;visibility:visible;transform:translateY(0)}
#top-btn:hover{background:var(--gold)}
#top-btn:hover svg{stroke:var(--navy)}
#top-btn svg{stroke:var(--white);transition:stroke .2s}

