<script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
<script>
window.addEventListener("scroll",()=>{
  document.getElementById("nav").classList.toggle("solid",scrollY>40);
  document.getElementById("top-btn").classList.toggle("show",scrollY>500);
},{passive:true});
document.getElementById("ham").addEventListener("click",()=>{document.getElementById("mob-menu").classList.toggle("open")});
function closeMob(){document.getElementById("mob-menu").classList.remove("open")}
const obs=new IntersectionObserver((entries)=>{entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add("visible");obs.unobserve(e.target)}})},{threshold:0.1,rootMargin:"0px 0px -40px 0px"});
document.querySelectorAll(".reveal").forEach(el=>obs.observe(el));
function submitForm(){alert("Thank you for your message!\n\nWe will be in touch within one business day.\n\n(246) 851-3750\numar@davissonassociates.com")}
if(window.netlifyIdentity){window.netlifyIdentity.on("init",user=>{if(!user){window.netlifyIdentity.on("login",()=>{document.location.href="/admin/"})}})}
</script>
